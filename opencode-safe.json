{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "mcp": {
    "servers": {
      "graf-memory": {
        "command": [
          "node",
          "$HOME/workspace/tools/grafmcp/src/index.js"
        ],
        "enabled": true,
        "type": "local"
      }
    }
  },
  "model": "opencode/nemotron-3-ultra-free",
  "permission": {
    "*": "ask",
    "bash": {
      "*": "allow",
      "apt *": "deny",
      "apt-get *": "deny",
      "chmod -R *": "deny",
      "chown *": "deny",
      "curl * | bash": "deny",
      "curl * | sh": "deny",
      "dd *": "deny",
      "git push *": "deny",
      "mkfs*": "deny",
      "npm publish*": "deny",
      "pip install *": "deny",
      "rm -rf *": "deny",
      "rm -rf /": "deny",
      "rm -rf ~*": "deny",
      "shutdown*": "deny",
      "sudo *": "deny",
      "wget * | sh": "deny"
    },
    "edit": {
      "*": "allow"
    },
    "glob": {
      "*": "allow"
    },
    "grep": {
      "*": "allow"
    },
    "read": {
      "*": "allow"
    },
    "webfetch": "allow",
    "write": {
      "*": "allow"
    }
  }
}